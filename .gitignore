# ============================
# RHR APP Phase 1 — root ignore
# ============================

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Node (backend + desktop) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- Backend runtime data ---
RHR-backend/session_data/
RHR-backend/.wwebjs_cache/
RHR-backend/.wwebjs_auth/

# --- Desktop (Electron / React) build output ---
RHR-desktop/build/
RHR-desktop/dist/

# --- Flutter / Dart (frontend) ---
RHR-frontend/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/doc/api/
**/ios/Flutter/.last_build_id
**/android/.gradle/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# --- IDE / editor ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.DS_Store

# --- Claude Code local config (machine-specific, not project code) ---
.claude/

# --- OS ---
Thumbs.db
