{
  "name": "rhr-desktop",
  "version": "1.0.0",
  "description": "RHR & Company — Admin Desktop Panel",
  "private": true,
  "main": "electron.js",
  "homepage": "./",
  "author": "RHR & Company",
  "dependencies": {
    "axios": "^1.7.9",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.4",
    "wait-on": "^8.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "node electron-launcher.js",
    "web": "cross-env PORT=3001 BROWSER=none ESLINT_NO_DEV_ERRORS=true react-scripts start",
    "dev": "concurrently -k -n REACT,ELECTRON -c green,blue \"cross-env PORT=3001 BROWSER=none npm start\" \"wait-on http://localhost:3001 && node electron-launcher.js\"",
    "electron-pack": "npm run build && electron-builder --win nsis",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.rhrcompany.admin",
    "productName": "RHR Admin",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "build/**/*",
      "electron.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron.js"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
